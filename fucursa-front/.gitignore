# Next.js specific gitignore
# (Common rules like node_modules, .env, etc. are handled by root .gitignore)

# Next.js build outputs
/.next/
/out/
/build

# Testing
/coverage

# Production
*.tsbuildinfo
next-env.d.ts

# Vercel deployment
.vercel

# Yarn
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
